# Only used by docker-compose.caddy.yml.

{
	on_demand_tls {
		ask http://app:8000/api/caddy/ask
	}
}

{$CADDY_HOST::80} {
	reverse_proxy app:8000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

:443 {
	tls {
		on_demand
	}
	reverse_proxy app:8000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
