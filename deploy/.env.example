# ============================================================
# Quickly – environment configuration for the Aether cold-email setup.
# Copy to `.env` (the install script does this for you) and fill in
# the blanks. Everything else (sequences, limits, campaigns) is
# configured later in the web UI, not here.
# ============================================================

# ── Infrastructure ───────────────────────────────────────────

# Only used by docker-compose.caddy.yml. Your public domain, e.g.
# aether-mail.yourdomain.com. Leave blank if using docker-compose.no-caddy.yml
# behind an existing reverse proxy.
CADDY_HOST=

# Full public URL leads and OAuth providers will see. Must match how you
# actually reach the app (your domain over https, once DNS + proxy are live).
BASE_URL=https://CHANGE_ME.example.com

# Random signing key so admin sessions survive a container restart.
# The install script generates this for you with `openssl rand -hex 32`.
QUICKLY_SECRET_KEY=

# ── Google OAuth (only needed to connect Gmail inboxes) ──────
# Create in Google Cloud Console: enable "Gmail API", configure the OAuth
# consent screen, add an OAuth Web Application client with redirect URIs:
#   https://YOUR_DOMAIN/oauth/app/google/callback
#   https://YOUR_DOMAIN/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft / Office 365 OAuth (only needed for Outlook/M365) ──
# Azure Portal -> App registrations -> New registration. Redirect URIs:
#   https://YOUR_DOMAIN/oauth/office365/callback
#   https://YOUR_DOMAIN/oauth/app/office365/callback
# API permissions (delegated): Mail.ReadWrite, Mail.Send, User.Read, offline_access
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
OFFICE365_TENANT_ID=common

# ── Generic SMTP inboxes ─────────────────────────────────────
# Per-inbox SMTP/IMAP credentials are entered in the web UI, not here.
# Leave the lines below commented out unless you are connecting a
# self-hosted/internal test SMTP server (e.g. Mailpit) for step 10 below.
# SMTP_ALLOW_PRIVATE_HOSTS=true
# SMTP_ALLOW_PLAIN_SMTP=true

# ── CORS ─────────────────────────────────────────────────────
# Update to your real domain once you know it.
CORS_ORIGINS=https://CHANGE_ME.example.com
